{
  "rewrites": [
    {
      "source": "/_catalog",
      "destination": "https://arena-pure-catalog.onrender.com/api/v1/catalog/"
    },
    {
      "source": "/admin",
      "destination": "/management/index.html"
    },
    {
      "source": "/api/management/:path*",
      "destination": "https://arena-pure-catalog.onrender.com/api/management/:path*"
    },
    {
      "source": "/media/products/:path*",
      "destination": "https://arena-pure-catalog.onrender.com/media/products/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://arena-pure-catalog.onrender.com/api/v1/:path*"
    },
    {
      "source": "/media/articles/:path*",
      "destination": "https://arena-pure-catalog.onrender.com/media/articles/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/images/banners/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
